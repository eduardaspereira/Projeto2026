        "Anúncio" .

ns11:Aviso rdfs:label "Aviso"@pt ;
    rdfs:comment "Publicação informativa de entidade pública, sem carácter normativo direto."@pt ;
    rdfs:subClassOf ns11:AtoInformativo ;
    skos:notation "AVISO",
        "Aviso" .

ns11:AvisoExtrato rdfs:label "Aviso (extrato)"@pt ;
    rdfs:comment "Publicação resumida do essencial de um aviso."@pt ;
    rdfs:subClassOf ns11:Aviso ;
    skos:notation "Aviso (extracto)",
        "Aviso (extrato)" .

ns11:Constituicao rdfs:label "Constituição"@pt ;
