@prefix dct: <http://purl.org/dc/terms/> .
@prefix dre: <http://dre.pt/ontologia#> .
@prefix drex: <http://dre.pt/recurso/> .
@prefix ns1: <http://dre.pt/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://dre.pt/ontologia> a owl:Ontology ;
    rdfs:label "Ontology of the Portuguese Official Gazette"@en,
        "Ontologia do Diário da República Eletrónico"@pt ;
    dct:created "2026-05-06"^^xsd:date ;
    dct:language "pt" ;
    dct:subject "Diário da República",
        "Legislação Portuguesa" ;
    rdfs:comment """
        Ontologia que modela os atos normativos e documentos publicados no
        Diário da República Eletrónico (DRE) de Portugal.
        Cobre documentos desde 1910, incluindo leis, decretos, despachos,
        avisos, regulamentos e demais atos jurídico-administrativos.
    """@pt ;
    owl:imports dct: ;
    owl:versionInfo "1.0" .

dre:AnuncioProcedimento a owl:Class ;
    rdfs:label "Anúncio de Procedimento"@pt ;
    rdfs:comment "Publicação de abertura de concursos e procedimentos públicos."@pt ;
    rdfs:subClassOf dre:AtoInformativo ;
    skos:notation "Anúncio de procedimento" .

dre:AvisoContumax a owl:Class ;
    rdfs:label "Aviso de Contumácia"@pt ;
    rdfs:comment "Aviso de procedimento judicial por falta de comparência do arguido."@pt ;
    rdfs:subClassOf dre:AtoInformativo ;
    skos:notation "Aviso de Contumácia" .

dre:AvisoExtrato a owl:Class ;
    rdfs:label "Aviso (extrato)"@pt ;
    rdfs:comment "Publicação resumida do essencial de um aviso."@pt ;
    rdfs:subClassOf dre:Aviso ;
    skos:notation "Aviso (extracto)",
        "Aviso (extrato)" .

dre:Constituicao a owl:Class ;
    rdfs:label "Constituição"@pt ;
    rdfs:comment "Lei fundamental do Estado."@pt ;
    rdfs:subClassOf dre:AtoNormativo .

dre:Contrato a owl:Class ;
    rdfs:label "Contrato"@pt ;
    rdfs:comment "Instrumento contratual de entidade pública publicado no DR."@pt ;
    rdfs:subClassOf dre:AtoAdministrativo ;
    skos:notation "Contrato" .

dre:Declaracao a owl:Class ;
    rdfs:label "Declaração"@pt ;
    rdfs:comment "Declaração de entidade pública com efeitos administrativos."@pt ;
    rdfs:subClassOf dre:AtoAdministrativo ;
    skos:notation "DECLARAÇÃO",
        "Declaração",
        "Declaração de Retificação" .

dre:DecretoLei a owl:Class ;
    rdfs:label "Decreto-Lei"@pt ;
    rdfs:comment "Ato legislativo do Governo com valor equivalente à lei."@pt ;
    rdfs:subClassOf dre:AtoNormativo ;
    skos:notation "DECRETO-LEI",
        "Decreto-Lei" .

dre:DecretoRegulamentar a owl:Class ;
    rdfs:label "Decreto Regulamentar"@pt ;
    rdfs:comment "Decreto destinado ao desenvolvimento e execução de leis."@pt ;
    rdfs:subClassOf dre:Decreto .

dre:Deliberacao a owl:Class ;
    rdfs:label "Deliberação"@pt ;
    rdfs:comment "Decisão colegial de órgão administrativo."@pt ;
    rdfs:subClassOf dre:AtoAdministrativo ;
    skos:notation "Deliberação",
        "Deliberação (extracto)",
        "Deliberação (extrato)" .

dre:DespachoExtrato a owl:Class ;
    rdfs:label "Despacho (extrato)"@pt ;
    rdfs:comment "Publicação resumida do essencial de um despacho."@pt ;
    rdfs:subClassOf dre:Despacho ;
    skos:notation "Despacho (extracto)",
        "Despacho (extrato)" .

dre:EdicaoDR a owl:Class ;
    rdfs:label "Edição do Diário da República"@pt ;
    rdfs:comment "Número específico de uma série do DR numa determinada data."@pt .

dre:Edital a owl:Class ;
    rdfs:label "Edital"@pt ;
    rdfs:comment "Publicação de carácter informativo de câmaras municipais e tribunais."@pt ;
    rdfs:subClassOf dre:AtoInformativo ;
    skos:notation "Edital" .

dre:EntidadeLocal a owl:Class ;
    rdfs:label "Entidade Local"@pt ;
    rdfs:comment "Autarquia, câmara municipal ou junta de freguesia."@pt ;
    rdfs:subClassOf dre:EntidadeEmissora .

dre:EntidadePublicaEmpresarial a owl:Class ;
    rdfs:label "Entidade Pública Empresarial"@pt ;
    rdfs:comment "Empresa pública ou entidade com estatuto especial."@pt ;
    rdfs:subClassOf dre:EntidadeEmissora .

dre:LeiOrganica a owl:Class ;
    rdfs:label "Lei Orgânica"@pt ;
    rdfs:comment "Lei com força reforçada que rege matérias constitucionalmente reservadas."@pt ;
    rdfs:subClassOf dre:Lei .

dre:Louvor a owl:Class ;
    rdfs:label "Louvor"@pt ;
    rdfs:comment "Distinção honorífica atribuída a funcionários ou entidades."@pt ;
    rdfs:subClassOf dre:AtoAdministrativo ;
    skos:notation "Louvor" .

dre:PDF a owl:Class ;
    rdfs:label "PDF"@pt ;
    rdfs:comment "Versão em PDF do documento."@pt ;
    rdfs:subClassOf dre:RecursoDigital .

dre:Portaria a owl:Class ;
    rdfs:label "Portaria"@pt ;
    rdfs:comment "Ato normativo de um ou mais membros do Governo, de alcance geral."@pt ;
    rdfs:subClassOf dre:AtoNormativo ;
    skos:notation "PORTARIA",
        "Portaria" .

dre:Regulamento a owl:Class ;
    rdfs:label "Regulamento"@pt ;
    rdfs:comment "Norma regulamentar de entidade pública."@pt ;
    rdfs:subClassOf dre:AtoNormativo ;
    skos:notation "Regulamento" .

dre:Resolucao a owl:Class ;
    rdfs:label "Resolução"@pt ;
    rdfs:comment "Resolução do Conselho de Ministros ou da Assembleia da República."@pt ;
    rdfs:subClassOf dre:AtoNormativo ;
    skos:notation "Resolução da Assembleia da República",
        "Resolução do Conselho de Ministros" .

dre:TextoIntegral a owl:Class ;
    rdfs:label "Texto Integral"@pt ;
    rdfs:comment "Versão em texto simples do conteúdo do documento."@pt ;
    rdfs:subClassOf dre:RecursoDigital .

dre:alteradoPor a owl:ObjectProperty ;
    rdfs:label "Alterado Por"@pt ;
    rdfs:comment "Liga um documento a outro que o alterou."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:DocumentoOficial .

dre:condicional a owl:DatatypeProperty ;
    rdfs:label "Condicional"@pt ;
    rdfs:comment "Indica se a vigência do documento está sujeita a condição."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:boolean .

dre:desenvolve a owl:ObjectProperty ;
    rdfs:label "Desenvolve / Regulamenta"@pt ;
    rdfs:comment "Liga um diploma regulamentar ao diploma que desenvolve."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:DocumentoOficial .

dre:dreKey a owl:DatatypeProperty ;
    rdfs:label "DRE Key"@pt ;
    rdfs:comment "Chave interna de identificação do documento no sistema DRE."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:string .

dre:emProcessamento a owl:DatatypeProperty ;
    rdfs:label "Em Processamento"@pt ;
    rdfs:comment "Indica se o documento está a ser processado na base de dados DRE."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:boolean .

dre:emVigor a owl:DatatypeProperty ;
    rdfs:label "Em Vigor"@pt ;
    rdfs:comment "Indica se o documento está atualmente em vigor (true) ou revogado (false)."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:boolean .

dre:erroPDF a owl:DatatypeProperty ;
    rdfs:label "Erro no PDF"@pt ;
    rdfs:comment "Indica se ocorreu um erro ao obter o PDF do documento."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:boolean .

dre:fonte a owl:DatatypeProperty ;
    rdfs:label "Fonte"@pt ;
    rdfs:comment "Referência bibliográfica da publicação no Diário da República."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:string .

dre:nomeEntidade a owl:DatatypeProperty ;
    rdfs:label "Nome da Entidade"@pt ;
    rdfs:comment "Designação oficial da entidade emissora."@pt ;
    rdfs:domain dre:EntidadeEmissora ;
    rdfs:range xsd:string .

dre:numero a owl:DatatypeProperty ;
    rdfs:label "Número do Documento"@pt ;
    rdfs:comment "Número oficial atribuído ao documento (ex: 68/2023)."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:string .

dre:numeroDR a owl:DatatypeProperty ;
    rdfs:label "Número do DR"@pt ;
    rdfs:comment "Número da edição do Diário da República onde foi publicado."@pt ;
    rdfs:domain dre:PublicacaoDR ;
    rdfs:range xsd:string .

dre:pertenceASerie a owl:ObjectProperty ;
    rdfs:label "Pertence à Série"@pt ;
    rdfs:comment "Liga uma publicação à série do DR a que pertence."@pt ;
    rdfs:domain dre:PublicacaoDR ;
    rdfs:range dre:SerieDR .

dre:publicadoEm a owl:ObjectProperty ;
    rdfs:label "Publicado Em"@pt ;
    rdfs:comment "Liga o documento à sua publicação específica no DR."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:PublicacaoDR .

dre:rectificadoPor a owl:ObjectProperty ;
    rdfs:label "Retificado Por"@pt ;
    rdfs:comment "Liga um documento à sua retificação."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:Rectificacao .

dre:revoga a owl:ObjectProperty ;
    rdfs:label "Revoga"@pt ;
    rdfs:comment "Liga um documento ao(s) documento(s) que revoga."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:DocumentoOficial ;
    owl:inverseOf dre:revogadoPor .

dre:serie a owl:DatatypeProperty ;
    rdfs:label "Série"@pt ;
    rdfs:comment "Número da série do DR (1 = Série I, 2 = Série II, 3 = Série III)."@pt ;
    rdfs:domain dre:PublicacaoDR ;
    rdfs:range xsd:integer .

dre:sumario a owl:DatatypeProperty ;
    rdfs:label "Sumário / Ementa"@pt ;
    rdfs:comment "Descrição sumária do conteúdo do documento (campo 'notes' no dataset)."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:string .

dre:suspensoPor a owl:ObjectProperty ;
    rdfs:label "Suspenso Por"@pt ;
    rdfs:comment "Liga um documento ao documento que o suspendeu."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:DocumentoOficial .

dre:temRecurso a owl:ObjectProperty ;
    rdfs:label "Tem Recurso Digital"@pt ;
    rdfs:comment "Liga um documento ao(s) seu(s) recurso(s) digital(is)."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:RecursoDigital .

dre:timestampCriacao a owl:DatatypeProperty ;
    rdfs:label "Timestamp de Criação"@pt ;
    rdfs:comment "Data e hora em que o registo foi criado na base de dados DRE."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:dateTime .

dre:tipoDocumento a owl:DatatypeProperty ;
    rdfs:label "Tipo de Documento"@pt ;
    rdfs:comment "Designação textual do tipo de documento (ex: 'Decreto-Lei', 'Portaria')."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:string .

dre:transponeDiretiva a owl:ObjectProperty ;
    rdfs:label "Transpõe Diretiva"@pt ;
    rdfs:comment "Liga um diploma nacional à diretiva europeia que transpõe."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range owl:Thing .

dre:urlTextoIntegral a owl:DatatypeProperty ;
    rdfs:label "URL do Texto Integral"@pt ;
    rdfs:comment "Endereço URL para o texto integral do documento."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:anyURI .

ns1:Avisonr2 a owl:Class ;
    rdfs:label "Aviso label 2"@pt,
        "Profile Views"@pt ;
    rdfs:subClassOf ns1:Aviso,
        ns1:EntidadeEmissora,
        ns1:novaclasse .

ns1:Decretoc%C3%B3pia a owl:Class ;
    rdfs:label "decreto copia"@pt ;
    rdfs:subClassOf ns1:Decreto .

ns1:gandaclasse a owl:Class ;
    rdfs:label "rotulo e label"@pt ;
    rdfs:subClassOf dre:Anuncio .

ns1:nova_entidade_em a ns1:EntidadeEmissora ;
    ns1:nome "nova entidade em" .

ns1:nova_entidade_local a ns1:EntidadeLocal,
        ns1:OrgaoSoberano ;
    ns1:nome "nova entidade local" .

ns1:reitificacao2 a owl:Class ;
    rdfs:label "rotulo e label 2"@pt ;
    rdfs:subClassOf dre:Rectificacao .

drex:AssembleiaRepublica a dre:OrgaoSoberano ;
    rdfs:label "Assembleia da República"@pt ;
    dre:nomeEntidade "Assembleia da República" .

drex:GovRegiaoAcores a dre:EntidadeRegional ;
    rdfs:label "Governo Regional dos Açores"@pt ;
    dre:nomeEntidade "Governo Regional dos Açores" .

drex:GovRegiaoMadeira a dre:EntidadeRegional ;
    rdfs:label "Governo Regional da Madeira"@pt ;
    dre:nomeEntidade "Governo Regional da Madeira" .

drex:MinisterioAdministracaoInterna a dre:Ministerio ;
    rdfs:label "Ministério da Administração Interna"@pt ;
    dre:nomeEntidade "Ministério da Administração Interna" .

drex:MinisterioDefesaNacional a dre:Ministerio ;
    rdfs:label "Ministério da Defesa Nacional"@pt ;
    dre:nomeEntidade "Ministério da Defesa Nacional" .

drex:MinisterioEducacao a dre:Ministerio ;
    rdfs:label "Ministério da Educação"@pt ;
    dre:nomeEntidade "Ministério da Educação" .

drex:MinisterioFinancas a dre:Ministerio ;
    rdfs:label "Ministério das Finanças"@pt ;
    dre:nomeEntidade "Ministério das Finanças" .

drex:MinisterioJustica a dre:Ministerio ;
    rdfs:label "Ministério da Justiça"@pt ;
    dre:nomeEntidade "Ministério da Justiça" .

drex:MinisterioNegociosEstrangeiros a dre:Ministerio ;
    rdfs:label "Ministério dos Negócios Estrangeiros"@pt ;
    dre:nomeEntidade "Ministério dos Negócios Estrangeiros" .

drex:MinisterioObrasPublicas a dre:Ministerio ;
    rdfs:label "Ministério das Obras Públicas"@pt ;
    dre:nomeEntidade "Ministério das Obras Públicas" .

drex:MinisterioSaude a dre:Ministerio ;
    rdfs:label "Ministério da Saúde"@pt ;
    dre:nomeEntidade "Ministério da Saúde" .

drex:MinisterioTrabalho a dre:Ministerio ;
    rdfs:label "Ministério do Trabalho"@pt ;
    dre:nomeEntidade "Ministério do Trabalho" .

drex:PresidenciaRepublica a dre:OrgaoSoberano ;
    rdfs:label "Presidência da República"@pt ;
    dre:nomeEntidade "Presidência da República" .

drex:SerieI a dre:SerieDR ;
    rdfs:label "Série I do Diário da República"@pt ;
    dre:serie 1 ;
    rdfs:comment "Publica atos normativos de maior força jurídica: leis, decretos-lei, portarias, etc."@pt .

drex:SerieII a dre:SerieDR ;
    rdfs:label "Série II do Diário da República"@pt ;
    dre:serie 2 ;
    rdfs:comment "Publica atos administrativos: avisos, despachos, deliberações, anúncios, etc."@pt .

drex:SerieIII a dre:SerieDR ;
    rdfs:label "Série III do Diário da República"@pt ;
    dre:serie 3 ;
    rdfs:comment "Publica atos de autarquias locais e outras entidades."@pt .

drex:TribunalConstitucional a dre:Tribunal ;
    rdfs:label "Tribunal Constitucional"@pt ;
    dre:nomeEntidade "Tribunal Constitucional" .

dre:Anuncio a owl:Class ;
    rdfs:label "Anúncio"@pt ;
    rdfs:comment "Publicação de carácter informativo geral."@pt ;
    rdfs:subClassOf dre:AtoInformativo ;
    skos:notation "ANÚNCIO",
        "Anúncio" .

dre:Aviso a owl:Class ;
    rdfs:label "Aviso"@pt ;
    rdfs:comment "Publicação informativa de entidade pública, sem carácter normativo direto."@pt ;
    rdfs:subClassOf dre:AtoInformativo ;
    skos:notation "AVISO",
        "Aviso" .

dre:Decreto a owl:Class ;
    rdfs:label "Decreto"@pt ;
    rdfs:comment "Ato normativo do Governo ou do Presidente da República."@pt ;
    rdfs:subClassOf dre:AtoNormativo ;
    skos:notation "DECRETO",
        "Decreto" .

dre:Despacho a owl:Class ;
    rdfs:label "Despacho"@pt ;
    rdfs:comment "Decisão de membro do Governo ou de titular de cargo público."@pt ;
    rdfs:subClassOf dre:AtoAdministrativo ;
    skos:notation "DESPACHO",
        "Despacho" .

dre:Lei a owl:Class ;
    rdfs:label "Lei"@pt ;
    rdfs:comment "Ato legislativo da Assembleia da República."@pt ;
    rdfs:subClassOf dre:AtoNormativo ;
    skos:notation "Lei" .

dre:Tribunal a owl:Class ;
    rdfs:label "Tribunal"@pt ;
    rdfs:comment "Órgão jurisdicional."@pt ;
    rdfs:subClassOf dre:EntidadeEmissora .

dre:claint a owl:DatatypeProperty ;
    rdfs:label "Identificador claint"@pt ;
    rdfs:comment "Identificador numérico único do documento na base de dados DRE."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:integer .

dre:dataPublicacao a owl:DatatypeProperty ;
    rdfs:label "Data de Publicação"@pt ;
    rdfs:comment "Data em que o documento foi publicado no Diário da República."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:date .

dre:emitidoPor a owl:ObjectProperty ;
    rdfs:label "Emitido Por"@pt ;
    rdfs:comment "Liga um documento à(s) entidade(s) que o emitiu/emitiram."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:EntidadeEmissora ;
    owl:inverseOf dre:emitiu .

dre:emitiu a owl:ObjectProperty ;
    rdfs:label "Emitiu"@pt ;
    rdfs:comment "Liga uma entidade aos documentos por ela emitidos."@pt ;
    rdfs:domain dre:EntidadeEmissora ;
    rdfs:range dre:DocumentoOficial .

dre:revogadoPor a owl:ObjectProperty ;
    rdfs:label "Revogado Por"@pt ;
    rdfs:comment "Liga um documento ao documento que o revogou."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range dre:DocumentoOficial .

dre:urlPDF a owl:DatatypeProperty ;
    rdfs:label "URL do PDF"@pt ;
    rdfs:comment "Endereço URL para o ficheiro PDF do documento no dre.pt."@pt ;
    rdfs:domain dre:DocumentoOficial ;
    rdfs:range xsd:anyURI .

