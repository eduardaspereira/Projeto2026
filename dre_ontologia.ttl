dre:AtoAdministrativo a owl:Class ;
    rdfs:label "Ato Administrativo"@pt ;
    rdfs:comment "Documento que produz efeitos concretos e individualizados."@pt ;
    rdfs:subClassOf dre:DocumentoOficial ;
    owl:disjointWith dre:AtoInformativo .

dre:AtoInformativo a owl:Class ;
    rdfs:label "Ato Informativo / Aviso"@pt ;
    rdfs:comment "Publicação de natureza informativa, sem efeitos normativos diretos."@pt ;
    rdfs:subClassOf dre:DocumentoOficial .

dre:AtoNormativo a owl:Class ;
    rdfs:label "Ato Normativo"@pt ;
    rdfs:comment "Documento com força normativa geral e abstrata."@pt ;
    rdfs:subClassOf dre:DocumentoOficial ;
    owl:disjointWith dre:AtoAdministrativo,
        dre:AtoInformativo .

dre:EntidadeEmissora a owl:Class ;
    rdfs:label "Issuing Body"@en,
        "Entidade Emissora"@pt ;
    rdfs:comment "Entidade pública responsável pela emissão de um documento oficial."@pt .

dre:Ministerio a owl:Class ;
    rdfs:label "Ministério"@pt ;
    rdfs:comment "Departamento ministerial do Governo."@pt ;
    rdfs:subClassOf dre:EntidadeEmissora .

dre:DocumentoOficial a owl:Class ;
    rdfs:label "Official Document"@en,
        "Documento Oficial"@pt ;
    rdfs:comment "Classe raiz de todos os documentos publicados no Diário da República."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dre:emitidoPor ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dre:dataPublicacao ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dre:claint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dre:urlPDF ] ;
    skos:definition "Qualquer ato jurídico ou administrativo publicado oficialmente no Diário da República Eletrónico."@pt .

